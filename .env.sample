# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- TypeSafe AI (Jev) ---------------------------------------------------
# Create a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=apikey_1234...
# Optional. Defaults to jev-latest.
# JEV_MODEL=jev-latest

# --- Chat model backend --------------------------------------------------
# Jev only returns typed judgments, so replies still come from a chat model.
# Priority: 1 openai (ChatGPT subscription), 2 nim (NVIDIA), 3 lmstudio.
# Leave unset to use the first configured one.
# openai needs a one-time sign-in: uv run python -m pilot_jev.chatgpt_login
LLM_PROVIDER=nim
# Optional. Defaults: openai -> gpt-5.5, nim -> nvidia/nemotron-3.5-lightning-30b-a3b,
# lmstudio -> google/gemma-4-e4b
# LLM_MODEL=
# Seconds. Hosted NIM can take over a minute per call. Defaults to 180.
# LLM_TIMEOUT=180
# NIM reasoning models sometimes put their thinking in the reply. false turns thinking off.
# Unset keeps the model default.
LLM_ENABLE_THINKING=false

# NVIDIA NIM (LLM_PROVIDER=nim). Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Leave unset for the hosted API catalog. Self-hosted NIM example:
# NVIDIA_BASE_URL=http://0.0.0.0:8000/v1

# LM Studio (LLM_PROVIDER=lmstudio), OpenAI-compatible server
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Not validated by LM Studio, any non-empty value works. Defaults to lm-studio.
# LMSTUDIO_API_KEY=lm-studio

# --- LangSmith tracing (optional, useful with LangGraph Studio) ----------
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=pilot-typesafeai-jev
